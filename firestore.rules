rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAlek() {
      return signedIn() && request.auth.token.email == "alekcaballeromusic@gmail.com";
    }

    function isCata() {
      return signedIn() && request.auth.token.email == "catalina.medina.leal@gmail.com";
    }

    function isTeam() {
      return isAlek() || isCata();
    }

    match /rentalOptions/{optionId} {
      allow read, create, update, delete: if isTeam();
    }

    // Claves temporales para el Modo Agente.
    // El equipo puede crear, listar y revocar. La clave en claro nunca se guarda
    // aqui: solo su hash SHA-256, que no es reversible.
    match /agentTokens/{tokenId} {
      allow read, create, update, delete: if isTeam();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
